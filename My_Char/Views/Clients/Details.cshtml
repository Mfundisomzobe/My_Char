@model My_Char.Models.Entities.Client
@{
    ViewData["Title"] = Model.FullName;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">@Model.FullName</h3>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><- Back</a>
</div>
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
<div class="card mb-3">
    <div class="card-body">
        <p><strong>Phone:</strong> @Model.Phone</p>
        <p><strong>Visits:</strong> @Model.VisitCount</p>
        <p><strong>No-shows:</strong> @Model.NoShowCount</p>
        <form asp-action="ResetNoShows" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <button class="btn btn-sm btn-outline-warning">Reset no-shows</button>
        </form>
        <form asp-action="Delete" method="post" class="d-inline"
              onsubmit="return confirm('Delete this client permanently?')">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <button class="btn btn-sm btn-outline-danger">Delete (POPIA)</button>
        </form>
    </div>
</div>
<div class="card mb-3">
    <div class="card-body">
        <h6>Notes</h6>
        <form asp-action="SaveNotes" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <textarea name="notes" class="form-control mb-2" rows="3">@Model.Notes</textarea>
            <button class="btn btn-dark btn-sm">Save notes</button>
        </form>
    </div>
</div>
<div class="card">
    <div class="card-header fw-bold">Recent appointments</div>
    <div class="card-body p-0">
        <table class="table mb-0">
            <thead class="table-light"><tr><th>Date</th><th>Service</th><th>Status</th></tr></thead>
            <tbody>
                @foreach (var a in Model.Appointments)
                {
                    <tr>
                        <td>@a.StartUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                        <td>@a.Service.Name</td>
                        <td>@a.Status</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>