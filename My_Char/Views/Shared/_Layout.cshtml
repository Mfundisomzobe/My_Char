<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · My Chair</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body { background:#faf7f2; font-family: system-ui, -apple-system, sans-serif; }
        .navbar-mychair { background:#2b1810; }
        .brand { font-weight:700; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark navbar-mychair mb-3">
        <div class="container">
            <a class="navbar-brand brand" asp-controller="Dashboard" asp-action="Index"> My Chair</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="nav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" asp-controller="Dashboard" asp-action="Index">Today</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Dashboard" asp-action="Stats">Stats</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Services" asp-action="Index">Services</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Clients" asp-action="Index">Clients</a></li>
                </ul>
                <ul class="navbar-nav">
                    <partial name="_LoginPartial" />
                </ul>
            </div>
        </div>
    </nav>
    <main class="container" style="max-width:840px">
        @RenderBody()
    </main>
    <footer class="text-center text-muted small py-4">
        We collect only your name and phone to manage appointments.
        Ask us anytime to delete your data.
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
